# 复制为本地 env 或在 run-dev.sh 里 export。全部留空 = 无 Key 演示模式(Mock provider)。

# ── LLM Provider(三选一;优先级 Vertex > AI Studio > Mock)─────────────
# ① Vertex AI(service account JSON;唯一支持出图/Imagen 的模式)
VERTEX_CREDENTIALS_FILE=
VERTEX_LOCATION=us-central1
VERTEX_PROJECT=                       # 留空则取 SA 自身的 project_id
IMAGEN_MODEL=imagen-3.0-generate-002  # 分镜/海报文生图模型(仅 Vertex)

# ② AI Studio(API key;不支持出图)
GEMINI_API_KEY=
GEMINI_BASE_URL=                      # 可选:OpenAI 兼容代理

# 文本模型:Vertex 默认 gemini-2.5-flash,AI Studio 默认 gemini-2.0-flash
GEMINI_MODEL=

# ── 登录鉴权(默认 admin/admin)──────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# ── 历史持久化(可选;docker compose up -d 起 Postgres)────────────────
# 默认库:postgres://drama:drama@localhost:5432/drama?sslmode=disable
# 留空则关闭持久化(生成仍可用,历史为空)
DATABASE_URL=

# ── 服务端口 ─────────────────────────────────────────────────────────
PORT=8080
